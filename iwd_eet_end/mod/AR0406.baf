IF
	OR(2)
		Global("FC_HAS_BG1","GLOBAL",0)
		!Global("JO_GLOBAL_IN_IWD1","GLOBAL",1)
	GlobalLT("FC_GLOBAL_IWD_VARIABLE","GLOBAL",6)
THEN
	RESPONSE #100
		SetGlobal("FC_GLOBAL_IWD_VARIABLE","GLOBAL",6)
		Continue()
END

IF
	!Global("JO_GLOBAL_IWD_BG2","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("JO_GLOBAL_IWD_BG2","GLOBAL",1)
		Continue()
END

IF
	//Global("FC_GLOBAL_IWD_VARIABLE","GLOBAL",0)
	Global("FCIWDELM_SPAWN","MYAREA",0)
	GlobalGT("CHAPTER","GLOBAL",17)
THEN
	RESPONSE #100
		//SetGlobal("FC_GLOBAL_IWD_VARIABLE","GLOBAL",1)
		SetGlobal("FCIWDELM_SPAWN","MYAREA",1)
		CreateCreature("FCIWDELM",[1027.1355],2)
		Continue()
END

// reSet primary BG2 talk
IF
	Global("FC_PREFER_IWD1","MYAREA",1)
	GlobalLT("FC_GLOBAL_IWD_VARIABLE","GLOBAL",6)
THEN
	RESPONSE #100
		SetGlobal("FC_PREFER_IWD1","MYAREA",0)
		SetGlobal("FC_GLOBAL_IWD_VARIABLE","GLOBAL",8)
		Continue()
END
