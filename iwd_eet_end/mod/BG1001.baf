IF
	Global("FC_HAS_BG1","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("FC_HAS_BG1","GLOBAL",1)
		Continue()
END

IF
	//Global("FC_GLOBAL_IWD_VARIABLE","GLOBAL",0)
	Global("FCIWDELM_SPAWN","MYAREA",0)
	GlobalGT("CHAPTER","GLOBAL",6)
THEN
	RESPONSE #100
		//SetGlobal("FC_GLOBAL_IWD_VARIABLE","GLOBAL",1)
		SetGlobal("FCIWDELM_SPAWN","MYAREA",1)
		CreateCreature("FCIWDELM",[332.466],6)
END

// reSet primary BG1 talk
IF
	Global("FC_PREFER_IWD2","MYAREA",1)
	GlobalGT("FC_GLOBAL_IWD_VARIABLE","GLOBAL",3)
THEN
	RESPONSE #100
		SetGlobal("FC_PREFER_IWD2","MYAREA",0)
		SetGlobal("FC_GLOBAL_IWD_VARIABLE","GLOBAL",2)
		Continue()
END
